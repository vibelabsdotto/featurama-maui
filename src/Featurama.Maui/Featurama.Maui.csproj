<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios26.5;net10.0-maccatalyst26.5</TargetFrameworks>
    <UseMaui Condition="'$(TargetFramework)' != 'net10.0'">true</UseMaui>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Featurama.Maui</RootNamespace>
    <PackageId>Featurama.Maui</PackageId>
    <Version>1.0.0</Version>
    <Authors>Featurama</Authors>
    <Description>.NET MAUI client and native UI for Featurama feature requests, voting and comments.</Description>
    <PackageTags>maui;sdk;feature-requests;featurama</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://featurama.app</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vibelabsdotto/featurama-maui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Requires .NET 10. Default API moved to newapi.featurama.app; legacy callers must set BaseUrl explicitly. Adds owner editing, comments and permission-free native metadata.</PackageReleaseNotes>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="bin/**;obj/**" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="UI/**" />
  </ItemGroup>
</Project>
